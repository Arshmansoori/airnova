RewriteEngine On

# Block sensitive extensions
RewriteRule ^(?:\.env|.*\.sqlite|.*\.log|.*\.bak)$ - [F,L]

# Custom 404 page
ErrorDocument 404 /404.html

# Clean URL Routing for Airnova
RewriteRule ^aqi/?$ aqi.html [L]
RewriteRule ^station/?$ station.html [L]
RewriteRule ^weather/?$ weather.html [L]
RewriteRule ^airvision/?$ airvision.html [L]
RewriteRule ^(?:2|admin)/?$ aqi.html [L]
RewriteRule ^forecast/?$ prediction/ [R=301,L]

# Allow direct access to existing files and directories
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
